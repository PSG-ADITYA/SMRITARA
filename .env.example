# SMRITARA 3.1 — Production Environment Template
#
# NOTE: This file is a template. Never commit real API keys or credentials to Git.
# Copy this file to `.env` on your local development machine or configure in your deployment platform (e.g. Vercel).

# 1. Google Gemini API Key (Server-Side Proxy only)
# Used exclusively by /api/coach serverless function / dev proxy.
# NEVER expose to client bundles or prefix with VITE_.
GEMINI_API_KEY=

# 2. Supabase Cloud Database & Authentication (Client & Server)
# Required for cross-device cloud persistence and account authentication.
# Obtain from your Supabase Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Server Port (Optional, defaults to 5173 for Vite dev)
PORT=5173
